# === Argus / NetGuard Configuration ===
# Copy this file to `.env` and fill in your keys.
# OR (recommended) use the Settings -> API Keys UI to store keys in the encrypted vault.
# Keys in the vault are AES-256-GCM encrypted with DPAPI key wrap (Windows) or PBKDF2 (other).
#
# .env is gitignored -- your keys never leave this machine.

# === AI Providers (optional -- pick the ones you use) ===
# Anthropic Claude -- get a key at https://console.anthropic.com/keys
ANTHROPIC_API_KEY=

# OpenAI ChatGPT -- get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini -- get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Local Ollama -- only set if you run Ollama locally
OLLAMA_BASE_URL=http://localhost:11434

# === Threat Intelligence (optional) ===
# VirusTotal -- free tier 4 req/min -- https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB -- free tier 1000 checks/day -- https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# MaxMind GeoIP2 -- license key + account id pair -- https://www.maxmind.com/en/account
MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=

# === Notifications (optional) ===
# Discord webhook URL -- Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# Telegram bot -- talk to @BotFather to create a bot, then /newbot
TELEGRAM_BOT_TOKEN=

# Telegram chat id -- send a message to your bot, then GET
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy the chat.id
TELEGRAM_CHAT_ID=
