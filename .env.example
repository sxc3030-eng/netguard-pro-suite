# === Argus / NetGuard Configuration ===
# Copy this file to `.env` and fill in your keys.
# OR (recommended) use the Secret Vault UI to store keys encrypted at rest:
#   - Argus:   open AI panel (Ctrl+J) -> gear icon -> Settings
#   - NetGuard: dashboard -> Threat Intelligence -> Secret Vault card
#
# The vault uses 3 layers of encryption:
#   Layer 1 - DPAPI (per-Windows-user)
#   Layer 2 - Windows Credential Manager (offline-disk-theft proof)
#   Layer 3 - Argon2id master password (memory-hard, full-system-compromise proof)
#
# Vault deps (optional but recommended):
#   pip install pywin32 keyring argon2-cffi
# Without them, the suite falls back to reading this .env file in plaintext.
#
# .env is gitignored -- your keys never leave this machine.

# === Secret Vault (advanced) ===
# Override the vault file location. Defaults to <repo>/argus_data/.secret_vault/
# SECRET_VAULT_ROOT=

# Use cheap Argon2 params for tests/CI only -- DO NOT enable in production.
# SECRET_VAULT_ARGON2_FAST=

# Idle-lock timeout in minutes (default 15, set 0 to disable).
# SECRET_VAULT_IDLE_TIMEOUT=15

# === AI Providers (optional -- pick the ones you use) ===
# Anthropic Claude -- get a key at https://console.anthropic.com/keys
ANTHROPIC_API_KEY=

# OpenAI ChatGPT -- get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini -- get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Local Ollama -- only set if you run Ollama locally
OLLAMA_BASE_URL=http://localhost:11434

# === Threat Intelligence (optional) ===
# VirusTotal -- free tier 4 req/min -- https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB -- free tier 1000 checks/day -- https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# MaxMind GeoIP2 -- license key + account id pair -- https://www.maxmind.com/en/account
MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=

# === Notifications (optional) ===
# Discord webhook URL -- Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# Telegram bot -- talk to @BotFather to create a bot, then /newbot
TELEGRAM_BOT_TOKEN=

# Telegram chat id -- send a message to your bot, then GET
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy the chat.id
TELEGRAM_CHAT_ID=
