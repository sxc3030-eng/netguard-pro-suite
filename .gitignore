# NetGuard runtime secrets (generated at startup)
.netguard_token
.netguard_backup_key
fim/data/.fim_hmac_key

# AI persistent memory (per-installation; user-specific findings)
netguard_ai_memory.md

# MaxMind GeoLite2 — license key + downloaded DBs (per-installation)
geoip/.maxmind_license
geoip/GeoLite2-*.mmdb

# License signing keys (NEVER commit the private key)
tools/keys/
*.priv
# Argus runtime data — ignore everything under argus_data/ EXCEPT the
# sandbox/ seed dir (default-shipped tracker blocklist). The negation
# below only works because we ignore CONTENTS via /* (not the dir
# itself). Re-include the sandbox seed file explicitly.
argus_data/*
!argus_data/sandbox/
argus_data/sandbox/*
!argus_data/sandbox/trackers_blocklist.txt
argus_cache/
